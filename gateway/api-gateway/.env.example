# Application configs
APP_NAME=api-gateway
APP_ENV=development # Options: development, staging, production
APP_VERSION=1.0.0

# Server configs
PORT=8080 # Positive integer port

# Logging & Observability configs
LOG_LEVEL=debug # Options: debug, info, warn, error
LOG_FORMAT=json # Options: json, text
TRACING_ENABLED=false # Options: true, false
TRACING_EXPORTER=stdout # Options: stdout, otlp, noop
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317 # Host:Port string

# GraphQL configs
GRAPHQL_PLAYGROUND_ENABLED=true # Options: true, false

# Rate Limiting configs
RATE_LIMIT_ENABLED=true # Options: true, false
RATE_LIMIT_MAX_REQUESTS=1000 # Number of requests allowed per window
RATE_LIMIT_WINDOW=1m # Duration string e.g. 1m, 30s, 5m

# JWT & Security configs
JWT_SECRET=gocart-secret-key-change-in-production
JWT_ISSUER=gocart-api-gateway

# gRPC Services Configs
GRPC_DEFAULT_TIMEOUT=5s
AUTH_SERVICE_GRPC_ADDR=localhost:50051
USER_SERVICE_GRPC_ADDR=localhost:50052
PRODUCT_SERVICE_GRPC_ADDR=localhost:50053
CATEGORY_SERVICE_GRPC_ADDR=localhost:50054
STORE_SERVICE_GRPC_ADDR=localhost:50055
MERCHANT_SERVICE_GRPC_ADDR=localhost:50056
CART_SERVICE_GRPC_ADDR=localhost:50057
INVENTORY_SERVICE_GRPC_ADDR=localhost:50058
ORDER_SERVICE_GRPC_ADDR=localhost:50059
PAYMENT_SERVICE_GRPC_ADDR=localhost:50060
DELIVERY_SERVICE_GRPC_ADDR=localhost:50061
RETURN_SERVICE_GRPC_ADDR=localhost:50062
RATING_SERVICE_GRPC_ADDR=localhost:50063
NOTIFICATION_SERVICE_GRPC_ADDR=localhost:50064

