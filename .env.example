# App Environment
APP_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=json

# Redis Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_CONNECT_TIMEOUT=5s
REDIS_MAX_RETRIES=3
REDIS_RETRY_INTERVAL=1s

# Tracing & Metrics
TRACING_ENABLED=true
TRACING_EXPORTER=stdout
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
