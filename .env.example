# App Environment
APP_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=json
ADMIN_API_KEY=strong-random-secret
ADMIN_USER_ID=super-admin-identity

# CORS Configs
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,X-Request-ID,X-Admin-Key
CORS_EXPOSED_HEADERS=Content-Length,Access-Control-Allow-Origin,Access-Control-Allow-Headers
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# PostgreSQL Infrastructure
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Redis Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_CONNECT_TIMEOUT=5s
REDIS_MAX_RETRIES=3
REDIS_RETRY_INTERVAL=1s

# Message Broker (Kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=gocart-service
KAFKA_CONNECT_TIMEOUT=10s
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_INTERVAL=1s

# Tracing & Metrics
TRACING_ENABLED=true
TRACING_EXPORTER=stdout
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

