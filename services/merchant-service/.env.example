# Application configs
APP_NAME=merchant-service
APP_ENV=development # Options: development, staging, production
APP_VERSION=1.0.0

# Server configs
PORT=7600 # Positive integer port
GRPC_PORT=50056 # Positive integer gRPC port

# Database configs
MERCHANT_SERVICE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.txgjxsullxdiszmefezf.supabase.co:5432/postgres
DB_MAX_CONNS=25 # Positive integer (e.g., 10, 25, 50)
DB_MIN_CONNS=2 # Positive integer (e.g., 2, 5)
DB_AUTO_MIGRATE=true # Options: true, false
DB_MIGRATIONS_PATH=./migrations

# Logging & Observability configs
LOG_LEVEL=info # Options: debug, info, warn, error
LOG_FORMAT=json # Options: json, text
TRACING_ENABLED=true # Options: true, false
TRACING_EXPORTER=stdout # Options: stdout, otlp, noop
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317 # Host:Port string

# Kafka & Outbox configs
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=merchant-service
OUTBOX_ENABLED=true # Options: true, false
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5
OUTBOX_BASE_RETRY_DELAY_MS=1000
OUTBOX_MAX_RETRY_DELAY_MS=60000
OUTBOX_DLQ_TOPIC=gocart.merchant.dlq

