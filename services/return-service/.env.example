# Application configs
APP_NAME=return-service
APP_ENV=development # Options: development, staging, production
APP_VERSION=1.0.0

# Server configs
PORT=9150 # Positive integer port
GRPC_PORT=50062

# Inter-service gRPC addresses
ORDER_SERVICE_GRPC_ADDR=localhost:50059
PRODUCT_SERVICE_GRPC_ADDR=localhost:50053
GRPC_TIMEOUT_SECONDS=5

# Return policy configs
RETURN_WINDOW_DAYS=7

# Database configs
RETURN_SERVICE_DATABASE_URL=postgresql://user:password@localhost:5432/return_db?sslmode=disable
DB_MAX_CONNS=25 # Positive integer (e.g., 10, 25, 50)
DB_MIN_CONNS=2 # Positive integer (e.g., 2, 5)
DB_AUTO_MIGRATE=true # Options: true, false
DB_MIGRATIONS_PATH=./migrations

# Kafka configs
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=return-service
KAFKA_ENABLED=true

# Outbox configs
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5

# Logging & Observability configs
LOG_LEVEL=debug # Options: debug, info, warn, error
LOG_FORMAT=json # Options: json, text
TRACING_ENABLED=false # Options: true, false
TRACING_EXPORTER=stdout # Options: stdout, otlp, noop
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317 # Host:Port string
