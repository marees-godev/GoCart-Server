# Application configs
APP_NAME=auth-service
APP_ENV=development # Options: development, staging, production
APP_VERSION=1.0.0

# Server configs
PORT=9451 # Positive integer port

# Database configs
AUTH_SERVICE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.yyfeqzdgrnfuyajfdtby.supabase.co:5432/postgres
DB_MAX_CONNS=25 # Positive integer (e.g., 10, 25, 50)
DB_MIN_CONNS=2 # Positive integer (e.g., 2, 5)
DB_AUTO_MIGRATE=true # Options: true, false
DB_MIGRATIONS_PATH=./migrations

# Logging & Observability configs
LOG_LEVEL=info # Options: debug, info, warn, error
LOG_FORMAT=json # Options: json, text
TRACING_ENABLED=true # Options: true, false
TRACING_EXPORTER=stdout # Options: stdout, otlp, noop
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317 # Host:Port string

# Auth configs
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY_MINUTES=60 # Positive integer in minutes (e.g., 15, 60, 1440)

# Email & Verification configs
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=your-verified-brevo-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_OTP_TTL_MINUTES=5

# Redis configs (for OTP storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0


# Downstream gRPC Services
USER_SERVICE_GRPC_ADDR=localhost:50052


# Downstream Services
MERCHANT_SERVICE_GRPC_URL=localhost:50056
