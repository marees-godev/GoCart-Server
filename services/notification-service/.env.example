# Application configs
APP_NAME=notification-service
APP_ENV=development # Options: development, staging, production
APP_VERSION=1.0.0

# Server configs
PORT=9099 # Observability HTTP server (/health, /ready, /metrics)
GRPC_PORT=50064
ORDER_SERVICE_GRPC_ADDR=localhost:50059
GRPC_LOOKUP_TIMEOUT=2s

# Database configs
NOTIFICATIONS_SERVICE_DATABASE_URL=postgresql://user:password@localhost:5432/notification_db?sslmode=disable
DB_MAX_CONNS=25 # Positive integer (e.g., 10, 25, 50)
DB_MIN_CONNS=2 # Positive integer (e.g., 2, 5)
DB_AUTO_MIGRATE=true # Options: true, false
DB_MIGRATIONS_PATH=./migrations

# Message Broker (Kafka) configs
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=gocart.notification-service.domain-events-group
KAFKA_ENABLED=true
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_INTERVAL=500ms
KAFKA_DLQ_SUFFIX=.dlq

# Web Push / VAPID configs (generate P-256 base64url keypair, never commit real private keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@gocart.local
PUSH_REQUEST_TIMEOUT=10s
PUSH_MAX_RETRIES=3
PUSH_RETRY_INTERVAL=500ms
PUSH_TTL_SECONDS=86400
PUSH_LOCAL_NOTIFICATIONS_ENABLED=true

# Logging & Observability configs
LOG_LEVEL=debug # Options: debug, info, warn, error
LOG_FORMAT=json # Options: json, text
TRACING_ENABLED=true # Options: true, false
TRACING_EXPORTER=stdout # Options: stdout, otlp, noop
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317 # Host:Port string

# Email configs (Brevo and Resend alone)
EMAIL_PROVIDER=resend_brevo # Options: resend_brevo, mock
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
BREVO_API_KEY=
BREVO_FROM_EMAIL=nikotest122@gmail.com
EMAIL_TIMEOUT=10s
