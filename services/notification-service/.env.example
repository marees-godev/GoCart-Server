# Application configs
APP_NAME=notification-service
APP_ENV=development # Options: development, staging, production
APP_VERSION=1.0.0

# Server configs
PORT=9099 # Positive integer port
GRPC_PORT=50064

# Database configs
NOTIFICATIONS_SERVICE_DATABASE_URL=postgresql://user:password@localhost:5432/notification_db?sslmode=disable
DB_MAX_CONNS=25 # Positive integer (e.g., 10, 25, 50)
DB_MIN_CONNS=2 # Positive integer (e.g., 2, 5)
DB_AUTO_MIGRATE=true # Options: true, false
DB_MIGRATIONS_PATH=./migrations

# Message Broker (Kafka) configs
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=gocart.notification-service.domain-events-group
KAFKA_ENABLED=true

# Logging & Observability configs
LOG_LEVEL=debug # Options: debug, info, warn, error
LOG_FORMAT=json # Options: json, text
TRACING_ENABLED=true # Options: true, false
TRACING_EXPORTER=stdout # Options: stdout, otlp, noop
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317 # Host:Port string

# Notification Providers Configs
EMAIL_PROVIDER=mock # Options: mock, smtp
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gocart.local
SMTP_USE_TLS=false
EMAIL_TIMEOUT=10s

SMS_PROVIDER=mock # Options: mock, twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
SMS_TIMEOUT=5s

PUSH_PROVIDER=mock # Options: mock, fcm
PUSH_SERVER_KEY=
PUSH_TIMEOUT=5s
