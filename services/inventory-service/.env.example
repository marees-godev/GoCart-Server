# Application configs
APP_NAME=inventory-service
APP_ENV=development # Options: development, staging, production
APP_VERSION=1.0.0

# Server configs
PORT=8300 # Positive integer HTTP port
GRPC_PORT=50058 # Positive integer gRPC port

# Downstream Service addresses
PRODUCT_SERVICE_GRPC_ADDR=localhost:50053
STORE_SERVICE_GRPC_ADDR=localhost:50055

# Database configs
INVENTORY_SERVICE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.yunldctgqfcbsgtgbigu.supabase.co:5432/postgres
DB_MAX_CONNS=25 # Positive integer (e.g., 10, 25, 50)
DB_MIN_CONNS=2 # Positive integer (e.g., 2, 5)
DB_AUTO_MIGRATE=true # Options: true, false
DB_MIGRATIONS_PATH=./migrations

# Reservation configs
RESERVATION_EXPIRATION_CLEANUP_INTERVAL_SECONDS=30 # Interval in seconds for cleaner worker
DEFAULT_RESERVATION_EXPIRATION_MINUTES=15 # Default reservation time-box TTL in minutes

# Logging & Observability configs
LOG_LEVEL=info # Options: debug, info, warn, error
LOG_FORMAT=json # Options: json, text
TRACING_ENABLED=true # Options: true, false
TRACING_EXPORTER=stdout # Options: stdout, otlp, noop
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317 # Host:Port string
