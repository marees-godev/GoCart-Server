# Application configs
APP_NAME=store-service
APP_ENV=development # Options: development, staging, production
APP_VERSION=1.0.0

# Server configs
PORT=7500 # Positive integer port

# Database configs
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.cljkfzbiywvhzpmlbbuy.supabase.co:5432/postgres
DB_MAX_CONNS=25 # Positive integer (e.g., 10, 25, 50)
DB_MIN_CONNS=2 # Positive integer (e.g., 2, 5)
DB_AUTO_MIGRATE=true # Options: true, false
DB_MIGRATIONS_PATH=./migrations

# Logging & Observability configs
LOG_LEVEL=info # Options: debug, info, warn, error
LOG_FORMAT=json # Options: json, text
TRACING_ENABLED=true # Options: true, false
TRACING_EXPORTER=stdout # Options: stdout, otlp, noop
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317 # Host:Port string

# Storage / S3 configs (Supabase S3)
S3_ENDPOINT=https://cljkfzbiywvhzpmlbbuy.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=YOUR_SUPABASE_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_SUPABASE_S3_SECRET_ACCESS_KEY
S3_BUCKET=stores
S3_PUBLIC_URL_PREFIX=https://cljkfzbiywvhzpmlbbuy.supabase.co/storage/v1/object/public/stores

