# Application configs
APP_NAME=payment-service
APP_ENV=development # Options: development, staging, production
APP_VERSION=1.0.0

# Server configs
PORT=8888 # Positive integer port

# Database configs
PAYMENT_SERVICE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.orhckblhpacvgwsxxppm.supabase.co:5432/postgres
DB_MAX_CONNS=25 # Positive integer (e.g., 10, 25, 50)
DB_MIN_CONNS=2 # Positive integer (e.g., 2, 5)
DB_AUTO_MIGRATE=true # Options: true, false
DB_MIGRATIONS_PATH=./migrations

# Logging & Observability configs
LOG_LEVEL=info # Options: debug, info, warn, error
LOG_FORMAT=json # Options: json, text
TRACING_ENABLED=true # Options: true, false
TRACING_EXPORTER=stdout # Options: stdout, otlp, noop
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317 # Host:Port string

# Payment Gateway & Webhook configs
PAYMENT_GATEWAY_PROVIDER=mock # Options: mock, razorpay
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx

# Kafka & Outbox Event Streaming configs
KAFKA_ENABLED=true # Options: true, false (set false in production if no Kafka broker is deployed)
KAFKA_BROKERS=localhost:9092 # Comma-separated list of broker addresses (e.g. kafka:9092 or your-cloud-broker:9092)
OUTBOX_ENABLED=true # Options: true, false
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5
OUTBOX_DLQ_TOPIC=gocart.dlq


