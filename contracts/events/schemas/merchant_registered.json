{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gocart.internal/events/merchant_registered.json",
  "title": "MerchantRegisteredEvent",
  "description": "Payload schema emitted when a merchant is registered in the system.",
  "type": "object",
  "properties": {
    "merchant_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier of the registered merchant."
    },
    "user_id": {
      "type": "string",
      "description": "Associated user identifier, if applicable."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Registered business or account email address."
    },
    "business_name": {
      "type": "string",
      "description": "Business or trade name."
    },
    "first_name": {
      "type": "string",
      "description": "Merchant owner first name."
    },
    "last_name": {
      "type": "string",
      "description": "Merchant owner last name."
    },
    "phone": {
      "type": "string",
      "description": "Merchant contact phone."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["merchant_id", "email"]
}
